# Slack
SLACK_APP_TOKEN=xapp-1-...
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=

# OpenAI (dev profile)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.chatanywhere.com.cn
OPENAI_MODEL=gpt-4o

# Google Gemini (uat / pro profile)
GOOGLE_GENAI_API_KEY=AIza...
GOOGLE_GENAI_MODEL=gemini-3.1-flash-lite-preview

# Git 認證 (PAT)
GIT_USERNAME=your-email@example.com
GIT_TOKEN=your-personal-access-token

# Git Repo URLs, API Hosts & Default Branches
REPO_TEST_URL=https://github.com/org/test-repo
REPO_TEST_API_HOST=http://localhost:8080
REPO_TEST_DEFAULT_BRANCH=main

# Spring Profile (dev / uat / pro)
SPRING_PROFILES_ACTIVE=dev

# API 寫入保護: POST /git/** 需帶 X-Api-Token 標頭,未設定時寫入端點一律回 403
API_WRITE_TOKEN=

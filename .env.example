# Slack
SLACK_APP_TOKEN=xapp-1-...
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=

# OpenAI (dev profile)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.chatanywhere.com.cn
OPENAI_MODEL=gpt-4o

# Google Gemini (uat / pro profile)
GOOGLE_GENAI_API_KEY=AIza...
GOOGLE_GENAI_MODEL=gemini-3.1-flash-lite

# Google Gemini rate limiting
GOOGLE_GENAI_RATE_LIMIT_ENABLED=true
GOOGLE_GENAI_RPM=30
GOOGLE_GENAI_TPM=1000000
GOOGLE_GENAI_RPD=1500
GOOGLE_GENAI_MAX_WAIT_MILLIS=300000

# Git 認證 (PAT)
GIT_USERNAME=your-email@example.com
GIT_TOKEN=your-personal-access-token

# Git Repo URLs, API Hosts & Default Branches
# 每個註冊 repo 一組 REPO_{NAME}_* 變數；java-system-agent 是本 repo 自身，作為示範分析對象
REPO_JAVA_SYSTEM_AGENT_URL=https://github.com/org/java-system-agent
REPO_JAVA_SYSTEM_AGENT_API_HOST=http://localhost:8080
REPO_JAVA_SYSTEM_AGENT_DEFAULT_BRANCH=master

# Spring Profile (dev / uat / pro)
SPRING_PROFILES_ACTIVE=dev

# API 寫入保護: POST /git/** 需帶 X-Api-Token 標頭,未設定時寫入端點一律回 403
API_WRITE_TOKEN=

# MongoDB / durable agent trace
# 預設帳密與 docker-compose 內建 mongo 服務一致,覆寫時兩邊自動同步
MONGO_USERNAME=agent
MONGO_PASSWORD=agent
# 完整連線字串(選填);未設定時由上方帳密組合預設值
#MONGO_URI=mongodb://agent:agent@127.0.0.1:27017/java_system_agent?authSource=admin
# trace 持久化開關:true 寫入 MongoDB,false 用 in-memory(dev/pro 預設)
TRACE_PERSISTENCE_ENABLED=false
# 完全不載入 Mongo autoconfig 時使用(選填)
#SPRING_AUTOCONFIGURE_EXCLUDE=org.springframework.boot.autoconfigure.data.mongo.MongoDataAutoConfiguration,org.springframework.boot.autoconfigure.mongo.MongoAutoConfiguration

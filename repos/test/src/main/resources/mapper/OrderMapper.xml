<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mybatisplus.OrderMapper">

    <select id="findByOrderNo" resultType="com.example.mybatisplus.Order">
        SELECT  id,
                order_no,
                status,
                tenant_id
        FROM    orders
        WHERE   order_no = #{orderNo}
    </select>

</mapper>
